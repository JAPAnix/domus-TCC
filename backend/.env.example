# Prisma CLI: mesma conexão das variáveis DATABASE_* abaixo. Codifique caracteres especiais na URL.
DATABASE_URL=
PORT=3000
DATABASE_SSL=false
# CA PEM opcional, apenas se exigida pelo provedor. Nunca desative a validação do certificado.
DATABASE_SSL_CA=
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
JWT_SECRET=
FRONTEND_URL=http://localhost:5173/tecti/2026/gpec10
GOOGLE_CLIENT_ID=
# E-mail (recuperação de senha, códigos e avisos). Duas opções; EMAIL_FROM é obrigatório nas duas.
# 1) Brevo, por API HTTPS (gratuito, 300 por dia, funciona no plano gratuito do Render, que bloqueia SMTP). Veja o README.
BREVO_API_KEY=
# 2) SMTP (não funciona em hospedagens que bloqueiam as portas 25, 465 e 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_LOGO_URL=
NODE_ENV=development
# console only works in development and does NOT send a real SMS.
# Production must use twilio with real credentials.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Usada pela CLI do Prisma (migrations).
DATABASE_URL=mysql://usuario:senha@localhost:3306/banco
PORT=3000
# Fotos: local grava em backend/uploads (desenvolvimento); cloudinary é para produção.
STORAGE_PROVIDER=local
# Taxa da plataforma sobre cada serviço, em %. Começa em 0.
PLATFORM_FEE_PERCENT=0
# E-mail da equipe que recebe os chamados da Central de Ajuda (opcional; precisa do SMTP configurado).
SUPPORT_EMAIL=
# Endereço público da API, usado nas URLs das fotos locais. Vazio: usa o endereço da requisição.
PUBLIC_BASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pagamentos. "manual" (padrão) = Pix, dinheiro ou cartão presencial combinados direto, sem custo e sem integração.
# "mercadopago" liga o Pix automático (precisa das 3 variáveis abaixo; veja o README). Faltando alguma, volta ao manual.
# "asaas" liga o pagamento pela plataforma (Pix, cartão e boleto com split). Veja "Ativar o pagamento pela plataforma" no README.
# Basta trocar esta variável (com as ASAAS_* e SECRETS_KEY preenchidas). Faltando alguma, volta ao manual.
PAYMENT_PROVIDER=manual
MP_ACCESS_TOKEN=
# Segredo da assinatura do webhook (Painel de desenvolvedores do Mercado Pago > Webhooks).
MP_WEBHOOK_SECRET=
# Endereço público da API, para o Mercado Pago chamar o webhook (ex.: https://api.seudominio.com).
PUBLIC_API_URL=

# Atrás de proxy (Render, Fly...), use 1 para o limite de taxa enxergar o IP real do visitante.
TRUST_PROXY=
# Pasta das fotos do provedor local (opcional; padrão backend/uploads).
UPLOAD_DIR=
# Só para testes: endereço da API do Mercado Pago (vazio usa o oficial).
MP_API_URL=

# ---- Pagamento pela plataforma (Asaas). Só vale com PAYMENT_PROVIDER=asaas. Com PAYMENT_PROVIDER=manual nada muda.
# Precisa de uma conta Asaas de CNPJ (subcontas, split e garantia não existem para CPF).
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Token que o Asaas envia no cabeçalho do webhook (de 32 a 255 caracteres, sem espaços; não pode ser uma chave de API).
ASAAS_WEBHOOK_TOKEN=
# Opcional: sobrescreve a URL base (testes). Vazio usa o endereço oficial do ambiente.
ASAAS_BASE_URL=
# Chave que cifra, no banco, a chave de API de cada subconta (32 bytes em base64).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=
# Taxas e prazos (todos opcionais; valores abaixo são os padrões).
CLIENT_FEE_PERCENT=0
PRO_COMMISSION_PERCENT=10
# professional: a taxa do gateway sai da parte do profissional. platform: a plataforma absorve.
GATEWAY_FEE_PAYER=professional
# Dias de garantia na Conta Escrow (precisa ser maior que AUTO_CONFIRM_DAYS).
ESCROW_DAYS=14
# Dias até a confirmação automática do serviço, se o cliente não reclamar.
AUTO_CONFIRM_DAYS=7
# Conta Escrow (garantia) do Asaas. DESLIGADA por padrão: pode ter mensalidade por subconta. Leia o README antes de ligar.
ESCROW_ENABLED=false

# Pedido aberto ("Publicar um pedido" do cliente e "Oportunidades" do profissional). Todos opcionais; os valores abaixo são os padrões.
# false desliga a funcionalidade inteira (telas somem, rotas respondem 404); pedidos antigos continuam acessíveis.
OPEN_REQUESTS_ENABLED=true
# Quantas propostas cada pedido aceita.
OPEN_REQUEST_MAX_PROPOSALS=5
# Validade padrão do pedido, em dias (as opções são 3, 7, 15 e 30).
OPEN_REQUEST_DEFAULT_DAYS=7
# Limites por cliente: pedidos publicados em 24 horas e pedidos abertos ao mesmo tempo.
OPEN_REQUEST_MAX_PER_DAY=5
OPEN_REQUEST_MAX_ACTIVE=10
# No máximo um aviso de "novas oportunidades" por profissional a cada tantas horas.
OPEN_REQUEST_DIGEST_HOURS=6
# Validade padrão de uma proposta, em horas.
OPEN_REQUEST_PROPOSAL_VALIDITY_HOURS=72
